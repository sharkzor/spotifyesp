# Sonocotta HiFi-ESP32-S3-Plus: ESP32-S3-WROOM N8R8 (8 MB flash, 8 MB octal PSRAM),
# PCM5122 DAC, optional W5500 Ethernet module. Pins from sonocotta/esp32-audio-dock.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPOTIFY_I2S_BCLK=14
CONFIG_SPOTIFY_I2S_LRCLK=15
CONFIG_SPOTIFY_I2S_DOUT=16
CONFIG_SPOTIFY_PCM5122=y
CONFIG_SPOTIFY_PCM5122_SDA=42
CONFIG_SPOTIFY_PCM5122_SCL=41
CONFIG_SPOTIFY_PCM5122_ADDR=77
CONFIG_SPOTIFY_PCM5122_XSMT=4
CONFIG_SPOTIFY_ETHERNET=y
CONFIG_SPOTIFY_ETH_SPI_CLK=12
CONFIG_SPOTIFY_ETH_SPI_MOSI=11
CONFIG_SPOTIFY_ETH_SPI_MISO=13
CONFIG_SPOTIFY_ETH_CS=10
CONFIG_SPOTIFY_ETH_INT=6
CONFIG_SPOTIFY_ETH_RST=5
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
