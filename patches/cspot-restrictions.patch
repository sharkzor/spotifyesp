+// Restrictions aimed at other account types (e.g. free) don't concern this
+// Premium receiver. Restrictions without a catalogue keep applying.
+static bool restrictionTargetsPremium(const Restriction& restriction) {
+  if (restriction.catalogue_str_count == 0) {
+    return true;
+  }
+  for (int x = 0; x < restriction.catalogue_str_count; x++) {
+    if (restriction.catalogue_str[x] != nullptr &&
+        strcmp(restriction.catalogue_str[x], "premium") == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
 bool doRestrictionsApply(Restriction* restrictions, int count,
                          const char* country) {
   for (int x = 0; x < count; x++) {
+    if (!restrictionTargetsPremium(restrictions[x])) {
+      continue;
+    }
+
     if (restrictions[x].countries_allowed != nullptr) {
       return !countryListContains(restrictions[x].countries_allowed, country);
     }
